{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@orca-plugins/ui-foundation"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Python stays on the version OrcaSlicer bundles for plugins (3.12, deps/python3/python3.cmake).",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    }
  ]
}
